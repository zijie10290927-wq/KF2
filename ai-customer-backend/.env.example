# ===== 应用 =====
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8000
CORS_ALLOWED_ORIGINS=*

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=ai_customer

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_embeddings

# ===== MinIO =====
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge
MINIO_SECURE=false

# ===== LLM 模型 (默认) =====
LLM_API_BASE=https://api.duc.ai/v1
LLM_API_KEY=sk-your-duc-api-key
LLM_MODEL_NAME=duc-v2

# ===== Embedding =====
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-dashscope-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ===== JWT 认证 =====
JWT_SECRET_KEY=please-change-this-secret-key-to-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ===== 加密 =====
CRYPTO_SECRET_KEY=please-change-this-32-byte-url-safe-base64-key

# ===== 限流 =====
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# ===== RAG 默认参数 =====
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.60
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# ===== 渠道适配层 (Section 11) =====
# Webhook 接收
WEBHOOK_ENABLED=true
WEBHOOK_HMAC_SECRET=please-change-webhook-hmac-secret

# OpenAI 兼容端点（/api/v1/openai/chat/completions）
OPENAI_COMPAT_ENABLED=true
OPENAI_COMPAT_API_KEY=please-change-openai-compat-api-key

# JS Widget（/api/v1/widget/*）
WIDGET_ENABLED=true
WIDGET_APP_KEYS=  # 逗号分隔的 app_key 列表，如 widget-key-1,widget-key-2

# 智齿科技
ZHIBO_API_BASE=https://api.sobot.com
ZHIBO_API_TOKEN=
ZHIBO_WEBHOOK_SECRET=
ZHIBO_APP_KEY=

# Chatwoot（可选）
CHATWOOT_API_BASE=
CHATWOOT_ACCESS_TOKEN=

# JWT 中间件排除路径（渠道适配层使用自身鉴权，不走 JWT）
AUTH_EXCLUDE_PATHS=/api/v1/auth/login,/api/v1/auth/register,/health,/docs,/redoc,/openapi.json,/favicon.ico,/,/api/v1/webhook/**,/api/v1/openai/**,/api/v1/widget/**
